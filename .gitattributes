# Default: text files use native auto
* text auto

# Scientific configs frozen with LF:
configs/alignment.yaml text eol=lf
configs/execution_phase7.yaml text eol=lf
configs/falsification.yaml text eol=lf
configs/methods.yaml text eol=lf
configs/preprocessing.yaml text eol=lf
configs/probes.yaml text eol=lf
configs/signals.yaml text eol=lf
configs/experiments/*.yaml text eol=lf
data/falsification/phase7_input_lock.json text eol=lf

# Scientific data and results frozen with CRLF:
configs/shifts.yaml text eol=crlf
configs/datasets.yaml text eol=crlf
data/manifests/** text eol=crlf
data/splits/** text eol=crlf
data/shifts/** text eol=crlf
data/probes/** text eol=crlf
data/signals/** text eol=crlf
data/falsification/offline_shift_replay/** text eol=crlf
results/** text eol=crlf

# Binary files must NEVER undergo line conversion (must appear last to override directory rules):
*.npy -text -diff eol=
*.npz -text -diff eol=
*.parquet -text -diff eol=
*.zip -text -diff eol=
*.tar.gz -text -diff eol=
*.gz -text -diff eol=
*.png -text -diff eol=
*.jpg -text -diff eol=
*.jpeg -text -diff eol=
*.xlsx -text -diff eol=
