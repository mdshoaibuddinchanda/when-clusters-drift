# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
build/
dist/

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & tool caches
.pytest_cache/
.coverage
htmlcov/

# Antigravity & IDE
.idea/
.vscode/
*.swp
*.swo

# =========================================================================
# Binary Data Files & Array Payloads (NEVER push data files to GitHub)
# =========================================================================
*.npz
*.npy
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.feather
*.arrow
*.bin
*.dat

# Data directories (per Phase 1 specification)
data/raw/**
data/canonical/**
data/synthetic/**
data/processed/**
data/splits/**
data/probes/**
data/shifts/cache/**
data/signals/**
runs/**
results/*
!results/baseline_validation/
!results/shift_validation/
!results/probe_validation/
!results/alignment_validation/
!results/falsification/

# Preserve gitkeep, manifests, and documentation
!data/processed/.gitkeep
!data/splits/.gitkeep
!data/splits/phase2_input_lock.json
!data/splits/split_manifest.json
!data/splits/preprocessing_audit.csv
!data/splits/**/*.json
!data/manifests/**
!data/README.md
!data/shifts/specs/**/*.json
!data/falsification/**/*.json
!results/baseline_validation/**
!results/shift_validation/**
!results/probe_validation/**
!results/alignment_validation/**
!results/falsification/**

# Credentials & secrets
kaggle.json
*.pem
*.key
.env

